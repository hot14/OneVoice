{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "level": { "type": "number" }
      },
      "required": ["uid", "email"]
    },
    "Vocabulary": {
      "title": "Vocabulary",
      "description": "Vocabulary item",
      "type": "object",
      "properties": {
        "word": { "type": "string" },
        "thai": { "type": "string" },
        "meaning": { "type": "string" }
      },
      "required": ["meaning"]
    },
    "Lesson": {
      "title": "Lesson",
      "description": "Lesson history",
      "type": "object",
      "properties": {
        "topic": { "type": "string" }
      },
      "required": ["topic"]
    },
    "Material": {
      "title": "Material",
      "description": "Study material metadata",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name"]
    },
    "Chunk": {
      "title": "Chunk",
      "description": "Text chunk with embedding",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "embedding": { "type": "array", "items": { "type": "number" } },
        "index": { "type": "number" }
      },
      "required": ["text", "embedding"]
    },
    "Node": {
      "title": "Node",
      "description": "Knowledge graph node",
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "type": { "type": "string", "enum": ["concept", "entity", "function", "module", "term"] },
        "description": { "type": "string" },
        "confidence": { "type": "number" }
      },
      "required": ["label", "type"]
    },
    "Edge": {
      "title": "Edge",
      "description": "Knowledge graph relationship",
      "type": "object",
      "properties": {
        "source": { "type": "string" },
        "target": { "type": "string" },
        "type": { "type": "string" },
        "confidence": { "type": "number" }
      },
      "required": ["source", "target", "type"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "User profile"
    },
    "/users/{userId}/vocabulary/{vocabId}": {
      "schema": { "$ref": "Vocabulary" },
      "description": "Vocabulary items"
    },
    "/users/{userId}/lessons/{lessonId}": {
      "schema": { "$ref": "Lesson" },
      "description": "Lesson history"
    },
    "/users/{userId}/materials/{materialId}": {
      "schema": { "$ref": "Material" },
      "description": "Study materials"
    },
    "/users/{userId}/materials/{materialId}/chunks/{chunkId}": {
      "schema": { "$ref": "Chunk" },
      "description": "Material chunks"
    },
    "/users/{userId}/materials/{materialId}/nodes/{nodeId}": {
      "schema": { "$ref": "Node" },
      "description": "Knowledge graph nodes"
    },
    "/users/{userId}/materials/{materialId}/edges/{edgeId}": {
      "schema": { "$ref": "Edge" },
      "description": "Knowledge graph edges"
    }
  }
}
