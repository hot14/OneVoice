# OneVoice v2 - Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# ============================================================================
# Required: Google Gemini API Configuration
# ============================================================================

# Google Gemini API Key
# Get your API key from: https://aistudio.google.com/app/apikey
# 1. Visit https://aistudio.google.com/app/apikey
# 2. Click "Create API Key" button
# 3. Select or create a Google Cloud project
# 4. Copy the generated API key
# 5. Paste below (do NOT commit this to git)
#
# Required for:
# - Real-time simultaneous interpretation via Gemini Live API WebSocket
# - Knowledge Guide chatbot responses
# - Session conversation summarization
# - Multi-turn chat history processing
#
# Pricing: $0.023 per minute of audio input/output (2-5 second latency)
# Free tier includes 60 requests per minute quota
#
# Security Notes:
# - NEVER commit this file to git with real keys
# - Use .gitignore to exclude .env.local (already configured)
# - Rotate this key periodically (recommend quarterly)
# - Delete keys from Google Cloud Console if compromised
# - Consider using short-lived credentials for production (v3.0 backend)
#
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# Optional: Analytics & Monitoring (for production deployments)
# ============================================================================

# Vercel Analytics Token (optional)
# Enable performance monitoring on Vercel deployments
# Get from: https://vercel.com/{project-name}/settings/analytics
# Tracks: Core Web Vitals, page load times, user interactions
# Leave empty to disable
#
VITE_VERCEL_ANALYTICS_ID=

# Sentry Error Tracking DSN (optional)
# Enable real-time error tracking and performance monitoring
# Get from: https://sentry.io/projects/{project-slug}/keys/
# Tracks: JavaScript errors, unhandled exceptions, performance metrics
# Leave empty to disable
#
VITE_SENTRY_DSN=

# ============================================================================
# Optional: Feature Flags (for A/B testing & gradual rollouts)
# ============================================================================

# Enable beta features for testing
# Set to "true" to activate beta features ahead of official release
# Used for: new UI layouts, experimental APIs, performance optimizations
#
VITE_ENABLE_BETA_FEATURES=false

# Enable debug logging in browser console
# Set to "true" for verbose console output during development
# Logs: WebSocket messages, audio processing, state transitions, API calls
# Leave as "false" for production (reduces console noise)
#
VITE_DEBUG_MODE=false

# ============================================================================
# Optional: Build & Deployment Configuration
# ============================================================================

# Application environment
# Values: "development" | "staging" | "production"
# Used for conditional logging, error reporting level, API endpoints
#
VITE_ENV=development

# Base URL for API requests (if migrating to backend in v3.0)
# Default: current domain (for frontend-only v2.0)
# Example: https://api.onevoice.app/v1
#
VITE_API_BASE_URL=

# ============================================================================
# Notes
# ============================================================================
#
# Setup Instructions:
# 1. Copy this file: cp .env.example .env.local
# 2. Edit .env.local and fill in GEMINI_API_KEY
# 3. Run dev server: npm run dev
# 4. Verify: Check browser console for "API key loaded" message
#
# Environment Variables Loading:
# - .env.local is loaded by Vite during development (npm run dev)
# - Build-time variables prefixed with VITE_ are embedded in the bundle
# - Runtime variables (non-VITE_ prefix) are only available in Node.js
#
# Security Best Practices:
# - .env.local is in .gitignore (never committed)
# - Use GitHub Secrets for CI/CD pipelines
# - Rotate GEMINI_API_KEY on schedule or after suspected compromise
# - Never share .env.local files in Slack, email, or chat
# - Use different API keys for dev/staging/production
#
# Troubleshooting:
# - "GEMINI_API_KEY is undefined" → Check .env.local exists with correct key
# - "Quota exceeded" → Check API usage at https://aistudio.google.com/billing
# - "Authentication failed (401)" → Verify API key is still valid
# - "WebSocket connection failed" → Check network and API key permissions
#
# For production deployments on Vercel/Netlify:
# 1. Set environment variables in platform settings (not in code)
# 2. Use GitHub Secrets for CI/CD workflows
# 3. Example Vercel: Dashboard → Settings → Environment Variables
# 4. Example Netlify: Site settings → Build & deploy → Environment
# 5. Example GitHub: Repo Settings → Secrets and variables → Actions
