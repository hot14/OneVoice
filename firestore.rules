rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - uid: string (required)
    //   - email: string (required)
    //   - displayName: string (optional)
    //   - level: number (optional)
    //
    // Collection: users/{userId}/vocabulary
    // Document ID: {vocabId}
    // Fields:
    //   - word: string (optional)
    //   - thai: string (optional)
    //   - meaning: string (required)
    //
    // Collection: users/{userId}/lessons
    // Document ID: {lessonId}
    // Fields:
    //   - topic: string (required)
    //
    // Collection: users/{userId}/materials
    // Document ID: {materialId}
    // Fields:
    //   - name: string (required)
    //   - content: string (optional)
    //   - createdAt: timestamp (optional)
    //
    // Collection: users/{userId}/materials/{materialId}/chunks
    // Document ID: {chunkId}
    // Fields:
    //   - text: string (required)
    //   - embedding: list (required)
    //   - index: number (optional)
    //
    // ===============================================================

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin check
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "gagatrack@gmail.com" && request.auth.token.email_verified == true);
    }

    // Validator functions
    function isValidUser(data) {
      return data.email is string && data.uid is string;
    }

    function isValidVocabulary(data) {
      return (data.word is string || data.thai is string) && data.meaning is string;
    }

    function isValidLesson(data) {
      return data.topic is string;
    }

    function isValidMaterial(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 255;
    }

    function isValidChunk(data) {
      return data.text is string && data.text.size() > 0 && data.embedding is list;
    }

    function isImmutable(field) {
      return !(field in request.resource.data) || request.resource.data[field] == resource.data[field];
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow update: if (isOwner(userId) && isImmutable('uid')) || isAdmin();
      allow delete: if isAdmin();
      allow create: if isOwner(userId) || isAdmin();

      match /vocabulary/{vocabId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && isValidVocabulary(request.resource.data);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /lessons/{lessonId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && isValidLesson(request.resource.data);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /materials/{materialId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && isValidMaterial(request.resource.data);
        allow delete: if isOwner(userId) || isAdmin();

        match /chunks/{chunkId} {
          allow read: if isOwner(userId) || isAdmin();
          allow create, update: if isOwner(userId) && isValidChunk(request.resource.data);
          allow delete: if isOwner(userId) || isAdmin();
        }

        match /nodes/{nodeId} {
          allow read: if isOwner(userId) || isAdmin();
          allow create, update, delete: if isOwner(userId) || isAdmin();
        }

        match /edges/{edgeId} {
          allow read: if isOwner(userId) || isAdmin();
          allow create, update, delete: if isOwner(userId) || isAdmin();
        }
      }

      match /conversations/{conversationId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
    }
  }
}
